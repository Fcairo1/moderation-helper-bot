<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.soundon.moderation-admin-sidecar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/bytedance/Desktop/moderation-helper-bot/mac_admin_sidecar.py</string>
        <string>--once</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/bytedance/Desktop/moderation-helper-bot</string>

    <!-- Runs once immediately when loaded, then every 300s (5 min). -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <!-- launchd's default PATH is minimal; bunx/bytedcli usually live under
         Homebrew or a Node version manager. Add common locations here — check
         `which bunx` in your normal shell and adjust if it's somewhere else. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/bytedance/.bun/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/bytedance/Desktop/moderation-helper-bot/moderation_bot/mac_admin_sidecar.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bytedance/Desktop/moderation-helper-bot/moderation_bot/mac_admin_sidecar.launchd.log</string>
</dict>
</plist>
